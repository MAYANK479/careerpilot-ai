PORT=5002

# AI Provider: "ollama" (default, free) or "openai" (requires API key)
AI_PROVIDER=ollama

# Ollama settings (for AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3

# OpenAI settings (for AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
